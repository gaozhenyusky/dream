# ========================================
# Dream Aptos 批量钱包与转账工具 - 环境变量配置
# ========================================

# ========================================
# 安全提醒
# ========================================
# 1. 请妥善保管助记词和私钥，不要泄露给他人
# 2. 生产环境请使用强密码和专用数据库用户
# 3. 建议在测试网先进行测试，确认无误后再在主网操作
# 4. 定期备份重要的配置信息和数据库数据
# 5. 不要将包含敏感信息的 .env 文件提交到版本控制系统 

# MySQL 数据库配置
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Aptos 网络环境
# 可选值: mainnet (主网), testnet (测试网), devnet (开发网)
# 默认: mainnet
NETWORK=mainnet
# 助记词 (Mnemonic)
# 用于批量生成钱包地址，请妥善保管，不要泄露给他人
# 格式: 12个或24个英文单词，用空格分隔
# 示例: word1 word2 word3 ... word12
MNEMONIC=
# 批量生成钱包数量
# 每次运行 generateWallets.ts 脚本时生成的钱包数量
BATCH_SIZE=


# ========================================
# 转账配置
# ========================================

# 发送方私钥
# 用于 batchTransferSingleBatch.ts 脚本进行批量转账
# 请确保私钥对应的地址有足够的 APT 余额
# 注意: 私钥是敏感信息，请妥善保管，不要提交到版本控制系统
SENDER_PRIVATE_KEY=
SEND_AMOUNT=

# ========================================
# 资金归集配置
# ========================================

# 归集目标地址
# 用于 batchCollect.ts 脚本，将多个地址的余额归集到此地址
# 请确保地址格式正确，建议先小额测试
COLLECT_ADDRESS=
