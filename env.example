# ========================================
# Dream Aptos 批量钱包与转账工具 - 环境变量配置
# ========================================
# 复制此文件为 .env 并填入实际配置值
# cp env.example .env

# ========================================
# Aptos 区块链配置
# ========================================

# Aptos 网络环境
# 可选值: mainnet (主网), testnet (测试网), devnet (开发网)
# 默认: mainnet
NETWORK=mainnet

# ========================================
# MySQL 数据库配置
# ========================================

# 数据库主机地址
# 本地开发通常为 localhost，生产环境请使用实际 IP 或域名
DB_HOST=localhost

# 数据库用户名
# 建议创建专用用户，避免使用 root
DB_USER=root

# 数据库密码
# 请使用强密码，生产环境务必更改默认密码
DB_PASSWORD=gao

# 数据库名称
# 脚本会自动创建此数据库（如果不存在）
DB_NAME=dream

# 数据库端口
# MySQL 默认端口为 3306
DB_PORT=3306

# ========================================
# 钱包管理配置
# ========================================

# 助记词 (Mnemonic)
# 用于批量生成钱包地址，请妥善保管，不要泄露给他人
# 格式: 12个或24个英文单词，用空格分隔
# 示例: "word1 word2 word3 ... word12"
MNEMONIC=

# 批量生成钱包数量
# 每次运行 generateWallets.ts 脚本时生成的钱包数量
# 建议根据网络状况调整，避免请求过于频繁
BATCH_SIZE=10

# ========================================
# 转账配置
# ========================================

# 发送方私钥
# 用于 batchTransferSingleBatch.ts 脚本进行批量转账
# 请确保私钥对应的地址有足够的 APT 余额
# 格式: 64位十六进制字符串，支持 0x 开头
# 示例: 0x1234567890abcdef... 或 1234567890abcdef...
# 注意: 私钥是敏感信息，请妥善保管，不要提交到版本控制系统
SENDER_PRIVATE_KEY=

# 转账金额 (APT)
# 实际转账金额 = SEND_AMOUNT * 100000000 (APT 有8位小数)
# 示例: 1.5 表示转账 1.5 APT
# 注意: 请确保账户余额充足，包括手续费
SEND_AMOUNT=1

# ========================================
# 资金归集配置
# ========================================

# 归集目标地址
# 用于 batchCollect.ts 脚本，将多个地址的余额归集到此地址
# 请确保地址格式正确，建议先小额测试
COLLECT_ADDRESS=


# ========================================
# 安全提醒
# ========================================
# 1. 请妥善保管助记词和私钥，不要泄露给他人
# 2. 生产环境请使用强密码和专用数据库用户
# 3. 建议在测试网先进行测试，确认无误后再在主网操作
# 4. 定期备份重要的配置信息和数据库数据
# 5. 不要将包含敏感信息的 .env 文件提交到版本控制系统
